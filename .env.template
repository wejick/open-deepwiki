# open-deepwiki configuration — copy to .env and fill in.
# Bun auto-loads .env from the project root. All values below are the defaults
# (from src/config/config.ts); only set what you need to change.

# ---------- LLM endpoint (powers wiki generation AND embeddings) ----------
# One OpenAI-compatible config. Works with OpenRouter, any OpenAI-compatible
# gateway, or a fully local server (Ollama, LiteLLM).
# For non-OpenRouter endpoints, openwiki switches to openai-compatible mode.
OPENROUTER_API_KEY=sk-or-...            # or ODW_LLM_API_KEY
ODW_LLM_MODEL=deepseek/deepseek-v4-flash   # model that writes the wiki pages
ODW_LLM_BASE_URL=https://openrouter.ai/api/v1   # local models: http://localhost:11434/v1

ODW_EMBEDDING_MODEL=openai/text-embedding-3-small
ODW_EMBEDDING_DIM=512                   # vectors truncated/padded to this dim (storage ~1x text)

# ---------- server ----------
ODW_DATA_DIR=./data                     # clones, index.db, registry, events, openwiki home
ODW_BIND_HOST=127.0.0.1                 # 0.0.0.0 to share on the LAN
ODW_PORT=7245
ODW_BEARER_TOKEN=                       # REQUIRED when bound beyond localhost

# ---------- producer (who writes the wiki) ----------
ODW_PRODUCER=openwiki                   # openwiki | claude
# The `claude` producer runs `claude -p` against the clone, billed to a Claude
# subscription instead of a metered endpoint. It needs the `claude` CLI on PATH
# and an authenticated config. Embeddings are unaffected — Claude has no
# embeddings endpoint, so ODW_EMBEDDING_* keeps its OpenAI-compatible provider.
ODW_CLAUDE_MODEL=claude-sonnet-5        # alias ('sonnet') or full model name
ODW_CLAUDE_MAP_MODEL=claude-haiku-4-5-20251001   # map session (empty = ODW_CLAUDE_MODEL)
ODW_CLAUDE_MAP_EFFORT=medium                      # map session (empty = ODW_CLAUDE_EFFORT)
ODW_CLAUDE_PLAN_MODEL=claude-haiku-4-5-20251001   # planner + every area session (empty = ODW_CLAUDE_MODEL)
ODW_CLAUDE_PLAN_EFFORT=high                       # planner + every area session (empty = ODW_CLAUDE_EFFORT)
ODW_CLAUDE_PAGE_MODEL=claude-sonnet-5             # page/overview/repair sessions (empty = ODW_CLAUDE_MODEL)
ODW_CLAUDE_PAGE_EFFORT=high                       # page/overview/repair sessions (empty = ODW_CLAUDE_EFFORT)
ODW_CLAUDE_EFFORT=medium                # low | medium | high | xhigh | max
ODW_CLAUDE_TIMEOUT_SEC=3600             # whole-run budget: planner + one session per page
ODW_CLAUDE_STEP_TIMEOUT_SEC=1800        # budget for one session (the planner, or one page)
# EMPTY BY DEFAULT ON PURPOSE: `claude` reads its credentials from its config
# dir, so pointing this at a fresh directory yields "Not logged in" on every
# run. Set it only to a directory you have authenticated into once.
ODW_CLAUDE_CONFIG_DIR=

# ---------- bundle acceptance ----------
# All four floors default to 0 = MEASURE BUT DO NOT GATE. Scores are recorded
# either way, so a regression is visible before it is enforced. Raise them once
# you have measured your own baseline (`bun run eval`); an uncalibrated floor
# rejects bundles from a producer that simply does not cite. For reference,
# openwiki's own output measures ~1.0 grounding at density 3.9-22.8/1000 words.
ODW_GROUNDING_MIN=0                     # min fraction of cited paths that resolve
ODW_GROUNDING_MIN_DENSITY=0             # min citations per 1000 body words
ODW_INIT_COVERAGE_MIN=0                 # min fraction of source dirs an init bundle cites
ODW_UPDATE_MAX_CHURN_RATIO=0            # max bundle churn / source churn on an update
# The churn ratio runs high by construction: a bundle has far fewer pages than
# the repo has files, so one page revised for one changed file out of 500 is
# already ~25x. Measure your own updates before picking a ceiling.
# A repo whose build never fits one budget window resumes across runs. After
# this many attempts the partial work is discarded and the repo is surfaced for
# a human — splitting it, excluding it, or running it against an API key.
ODW_MAX_RESUME_ATTEMPTS=3

# ---------- operations ----------
ODW_MAX_PARALLEL_INDEXING=2             # concurrent openwiki runs (batch import, nightly)
ODW_NIGHTLY_TIME=02:00                  # nightly refresh batch
ODW_OPENWIKI_VERSION=^0.3               # pinned openwiki CLI major version
ODW_OPENWIKI_TIMEOUT_SEC=3600           # per-repo openwiki run timeout
ODW_TOP_K_REPOS=5                       # fan-out for unscoped (cross-repo) searches
ODW_VECTOR_MIN_SIMILARITY=0.05          # below this, ask_repo says "no relevant content"

# ---------- source crawling ----------
ODW_INCLUDE_GLOBS=**
ODW_EXCLUDE_GLOBS=node_modules/**,.git/**,openwiki/**,dist/**,build/**,.env,.env.*,*.lock,package-lock.json,pnpm-lock.yaml,yarn.lock,*.min.js
ODW_MAX_FILE_SIZE_BYTES=1048576         # skip files larger than this (1MB)

# ---------- search tuning ----------
ODW_RG_TIMEOUT_MS=10000                 # ripgrep process timeout (then vector-only)
ODW_RG_MAX_COUNT=500                    # per-file match cap
ODW_FUSION_ASK_VECTOR_WEIGHT=1.0        # ask_repo: vector-leaning
ODW_FUSION_ASK_LEXICAL_WEIGHT=0.7
ODW_FUSION_CODE_VECTOR_WEIGHT=0.7       # search_code: lexical-leaning
ODW_FUSION_CODE_LEXICAL_WEIGHT=1.0

# ---------- logging ----------
ODW_EVENT_LOG_MAX_BYTES=10485760        # events.jsonl rotation size (10MB)
